#!/bin/bash
# Mock for `mountpoint`. Returns 0 (yes) or 1 (no) based on $MOCK_DIR.
# Write "yes" or "no" to $MOCK_DIR/mountpoint_<path with / → _> to control.
# A .seq file of the same name (one yes/no per line) is consumed first, one
# line per call, so a test can make a mount come back mid-run.
echo "mountpoint $*" >> "$MOCK_CALL_LOG"

# Last positional arg is the path being checked (after any -q / -- flags).
path="${*: -1}"
key="mountpoint_$(echo "$path" | tr '/' '_')"
seq="$MOCK_DIR/$key.seq"

if [ -s "$seq" ]; then
    answer=$(head -1 "$seq")
    tail -n +2 "$seq" > "$seq.tmp" && mv "$seq.tmp" "$seq"
elif [ -f "$MOCK_DIR/$key" ]; then
    answer=$(cat "$MOCK_DIR/$key")
else
    answer="no"
fi

[ "$answer" = "yes" ]
