#!/bin/bash
# ======================================================================================
# SCRIPT: Rclone Heartbeat (DUMB Edition)
# VERSION: v2.0-DUMB
# DESCRIPTION: Monitors the NzbDAV/InfiniDysk rclone mount that DUMB-2026 exposes on the
#              host via the shared bind (/mnt/debrid in the container →
#              /mnt/user/data/remote on the host) and recovers it with the least
#              disruptive action that works:
#
#                fail #1  restart "rclone w/ InfiniDysk" via the DUMB API
#                fail #2  restart "InfiniDysk", then rclone, via the DUMB API
#                fail #3+ docker restart DUMB-2026  (cooldown-gated)
#                MAX      hard reset: docker stop + start DUMB-2026
#
#              Without DUMB API credentials the first two rungs are skipped.
#              HARD_RESET=Y additionally wipes the rclone VFS cache (manual use only).
#
# v2.0: NzbDAV-only (Decypharr/Real-Debrid is disabled in DUMB). Removed the symlink
#       "priming" pass — `ls -d` on a symlink never touched the mount, so it did nothing.
# ======================================================================================

# --------------------------------------------------------------------------------------
# 1. USER CONFIGURATION (override in dumb.conf — see dumb.conf.example)
# --------------------------------------------------------------------------------------

DUMB_CONF="${DUMB_CONF:-/mnt/user/appdata/other/scripts/dumb-2026/dumb.conf}"
# shellcheck source=/dev/null
[ -f "$DUMB_CONF" ] && source "$DUMB_CONF"

SCRIPT_VERSION="v2.0-DUMB"
HARD_RESET="${HARD_RESET:-N}"                   # Y = stop DUMB-2026, wipe rclone cache, start. Manual use only.
MAX_FAILURES="${MAX_FAILURES:-5}"               # consecutive failed recoveries before the hard reset
RECOVERY_COOLDOWN_SEC="${RECOVERY_COOLDOWN_SEC:-900}"  # min seconds between container-level restarts
RECOVERY_WAIT_SEC="${RECOVERY_WAIT_SEC:-120}"   # how long to wait for the mount after a recovery action
PROBE_TIMEOUT="${PROBE_TIMEOUT:-10}"
PROBE_ATTEMPTS="${PROBE_ATTEMPTS:-3}"           # initial probe retries before declaring the mount down
STATE_FILE="${STATE_FILE:-/mnt/user/appdata/other/scripts/dumb-2026/prime_state.db}"
LOG_FILE="${LOG_FILE:-/mnt/user/appdata/other/scripts/dumb-2026/heartbeat.log}"

# --- MOUNT ---
NZB_MOUNT="${NZB_MOUNT:-/mnt/user/data/remote/nzbdav}"
NZB_PROBE_DIR="${NZB_PROBE_DIR:-completed-symlinks}"  # subdir that must list for the mount to count as up
NZB_WEBDAV_URL="${NZB_WEBDAV_URL-http://127.0.0.1:8089/}"  # InfiniDysk backend; empty = skip
RCLONE_CACHE_DIR="${RCLONE_CACHE_DIR:-/mnt/cache_ssd/rclone-cache/cache}"

# --- DOCKER ---
DUMB_CONTAINER="${DUMB_CONTAINER:-DUMB-2026}"
ENABLERS="${ENABLERS-binhex-prowlarr}"          # external containers DUMB depends on; started if down
FOUNDATION_WAIT_SEC="${FOUNDATION_WAIT_SEC:-30}"

# --- DUMB API (optional; enables per-process restarts) ---
DUMB_API_URL="${DUMB_API_URL:-http://127.0.0.1:3005/api}"
DUMB_API_USERNAME="${DUMB_API_USERNAME:-}"
DUMB_API_PASSWORD="${DUMB_API_PASSWORD:-}"
DUMB_RCLONE_PROCESS="${DUMB_RCLONE_PROCESS:-rclone w/ InfiniDysk}"
DUMB_NZB_PROCESS="${DUMB_NZB_PROCESS:-InfiniDysk}"

# --- BACKUP COORDINATION ---
# Set by appdata.backup pre-run hook; cleared by post-run hook.
BACKUP_PAUSE_FILE="${BACKUP_PAUSE_FILE:-/tmp/dumb-scripts.pause}"
BACKUP_PROC_PATTERN="${BACKUP_PROC_PATTERN:-(appdata\.backup|ca\.backup2).*backup\.(php|sh)}"
BACKUP_PAUSE_MAX_AGE_MIN="${BACKUP_PAUSE_MAX_AGE_MIN:-120}"

# --------------------------------------------------------------------------------------
# 2. HELPERS
# --------------------------------------------------------------------------------------

log_step() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"; }

send_notification() {
    /usr/local/emhttp/webGui/scripts/notify -e "Rclone Heartbeat" -s "$1" -d "$2" -i "$3"
}

_backup_in_progress() {
    if [ -f "$BACKUP_PAUSE_FILE" ]; then
        if find "$BACKUP_PAUSE_FILE" -mmin +"$BACKUP_PAUSE_MAX_AGE_MIN" 2>/dev/null | grep -q .; then
            rm -f "$BACKUP_PAUSE_FILE" 2>/dev/null || true  # stale — auto-clear
        else
            return 0  # fresh sentinel; backup is active
        fi
    fi
    pgrep -fq "$BACKUP_PROC_PATTERN" 2>/dev/null
}

container_running() {
    [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

# Mount check only — no network. A dead rclone leaves the mountpoint in place but
# readdir fails or hangs; the timeout turns a hang into a failure.
mount_up() {
    timeout "$PROBE_TIMEOUT" mountpoint -q "$NZB_MOUNT" || return 1
    timeout "$PROBE_TIMEOUT" ls "$NZB_MOUNT/$NZB_PROBE_DIR" > /dev/null 2>&1
}

# The rclone dir cache can keep answering readdir after InfiniDysk itself has died,
# so also check that the WebDAV backend replies at all (401 counts as alive).
backend_up() {
    [ -z "$NZB_WEBDAV_URL" ] && return 0
    local code
    code=$(curl -s -o /dev/null -m "$PROBE_TIMEOUT" -w '%{http_code}' "$NZB_WEBDAV_URL" 2>/dev/null)
    [ -n "$code" ] && [ "$code" != "000" ]
}

wait_for_mount() {
    local waited=0
    while [ "$waited" -lt "$RECOVERY_WAIT_SEC" ]; do
        sleep 10
        waited=$((waited + 10))
        if mount_up && backend_up; then
            log_step "RECOVERY: NzbDAV mount is back after ${waited}s."
            return 0
        fi
        log_step "WAITING: mount not back yet (${waited}/${RECOVERY_WAIT_SEC}s)..."
    done
    return 1
}

api_configured() {
    [ -n "$DUMB_API_URL" ] && [ -n "$DUMB_API_USERNAME" ] && [ -n "$DUMB_API_PASSWORD" ]
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

DUMB_TOKEN=""
api_login() {
    local body
    body=$(curl -s -m 15 -X POST "$DUMB_API_URL/auth/login" \
        -H 'Content-Type: application/json' \
        -d "{\"username\":\"$(json_escape "$DUMB_API_USERNAME")\",\"password\":\"$(json_escape "$DUMB_API_PASSWORD")\"}" 2>/dev/null)
    DUMB_TOKEN=$(printf '%s' "$body" | sed -n 's/.*"access_token" *: *"\([^"]*\)".*/\1/p')
    [ -n "$DUMB_TOKEN" ]
}

# POST /process/restart-service. Lifecycle calls can take a while server-side.
api_restart() {
    local process="$1" code
    code=$(curl -s -o /dev/null -m 180 -w '%{http_code}' -X POST "$DUMB_API_URL/process/restart-service" \
        -H "Authorization: Bearer $DUMB_TOKEN" -H 'Content-Type: application/json' \
        -d "{\"process_name\":\"$(json_escape "$process")\"}" 2>/dev/null)
    if [ "$code" = "200" ]; then
        log_step "API: restarted \"$process\"."
        return 0
    fi
    log_step "[!] API: restart of \"$process\" failed (HTTP ${code:-none})."
    return 1
}

save_state() {
    {
        echo "N_FAIL_COUNT=${N_FAIL_COUNT:-0}"
        echo "NZB_STATE=\"${NZB_STATE:-UNKNOWN}\""
        echo "NZB_START_TS=\"${NZB_START_TS:-0}\""
        echo "FOUNDATION_LAST_RESTART_TS=${FOUNDATION_LAST_RESTART_TS:-0}"
        echo "LAST_RECOVERY_TS=${LAST_RECOVERY_TS:-0}"
        echo "LAST_RECOVERY_ACTION=\"${LAST_RECOVERY_ACTION:-none}\""
    } > "$STATE_FILE"
}

set_nzb_state() {
    if [ "$NZB_STATE" != "$1" ]; then
        NZB_STATE="$1"
        NZB_START_TS=$(date +%s)
    fi
}

container_restart_allowed() {
    local now remaining
    now=$(date +%s)
    remaining=$(( RECOVERY_COOLDOWN_SEC - (now - FOUNDATION_LAST_RESTART_TS) ))
    if [ "$FOUNDATION_LAST_RESTART_TS" -gt 0 ] && [ "$remaining" -gt 0 ]; then
        log_step "[!] COOLDOWN: container restarted recently — skipping (${remaining}s left of ${RECOVERY_COOLDOWN_SEC}s, fail count $N_FAIL_COUNT/$MAX_FAILURES)."
        return 1
    fi
    return 0
}

hard_reset() {
    local wipe="$1"
    log_step "HARD RESET: stopping $DUMB_CONTAINER..."
    send_notification "Forced Reset" "Heartbeat hard reset of $DUMB_CONTAINER (fail count $N_FAIL_COUNT, cache wipe: $wipe)." "alert"
    docker stop "$DUMB_CONTAINER" > /dev/null 2>&1
    if [ "$wipe" = "Y" ] && [ -d "$RCLONE_CACHE_DIR" ]; then
        log_step "Wiping rclone VFS cache at $RCLONE_CACHE_DIR..."
        rm -rf "${RCLONE_CACHE_DIR:?}"/*
    fi
    sleep 5
    log_step "Starting $DUMB_CONTAINER..."
    docker start "$DUMB_CONTAINER" > /dev/null 2>&1
    FOUNDATION_LAST_RESTART_TS=$(date +%s)
    LAST_RECOVERY_TS=$FOUNDATION_LAST_RESTART_TS
    LAST_RECOVERY_ACTION="hard-reset"
    N_FAIL_COUNT=0
    set_nzb_state "DOWN"
    save_state
}

# --------------------------------------------------------------------------------------
# 3. MAIN
# --------------------------------------------------------------------------------------

mkdir -p "$(dirname "$STATE_FILE")" "$(dirname "$LOG_FILE")"

if _backup_in_progress; then
    log_step "[PAUSED] appdata backup in progress — skipping run"
    exit 0
fi

# Older state files carry Decypharr/priming keys; sourcing them is harmless.
# shellcheck source=/dev/null
[ -f "$STATE_FILE" ] && source "$STATE_FILE"
N_FAIL_COUNT=${N_FAIL_COUNT:-0}
FOUNDATION_LAST_RESTART_TS=${FOUNDATION_LAST_RESTART_TS:-0}
LAST_RECOVERY_TS=${LAST_RECOVERY_TS:-0}

log_step "HEARTBEAT $SCRIPT_VERSION — mount: $NZB_MOUNT | API restarts: $(api_configured && echo enabled || echo disabled)"

if [ "$HARD_RESET" = "Y" ]; then
    log_step "MANUAL RESET requested."
    hard_reset "Y"
    log_step "Manual hard reset complete. EXITING."
    exit 0
fi

# --- 3.1 FOUNDATION ---
FOUNDATION_STARTED=false
if ! container_running "$DUMB_CONTAINER"; then
    log_step "[!] $DUMB_CONTAINER is down. Starting..."
    docker start "$DUMB_CONTAINER" > /dev/null 2>&1
    FOUNDATION_LAST_RESTART_TS=$(date +%s)
    FOUNDATION_STARTED=true
fi
for container in $ENABLERS; do
    if ! container_running "$container"; then
        log_step "[!] $container is down. Starting..."
        docker start "$container" > /dev/null 2>&1
        FOUNDATION_STARTED=true
    fi
done
if [ "$FOUNDATION_STARTED" = "true" ]; then
    log_step "WAITING: ${FOUNDATION_WAIT_SEC}s for containers to initialise..."
    sleep "$FOUNDATION_WAIT_SEC"
fi

# --- 3.2 PROBE ---
MOUNT_OK=false
BACKEND_OK=false
attempt=1
while [ "$attempt" -le "$PROBE_ATTEMPTS" ]; do
    mount_up && MOUNT_OK=true || MOUNT_OK=false
    backend_up && BACKEND_OK=true || BACKEND_OK=false
    [ "$MOUNT_OK" = "true" ] && [ "$BACKEND_OK" = "true" ] && break
    log_step "WAITING: probe failed (mount=$MOUNT_OK backend=$BACKEND_OK, attempt $attempt/$PROBE_ATTEMPTS)..."
    [ "$attempt" -lt "$PROBE_ATTEMPTS" ] && sleep 6
    attempt=$((attempt + 1))
done

if [ "$MOUNT_OK" = "true" ] && [ "$BACKEND_OK" = "true" ]; then
    if [ "$NZB_STATE" = "DOWN" ]; then
        send_notification "Mount Restored" "NzbDAV mount at $NZB_MOUNT is back." "normal"
    fi
    set_nzb_state "UP"
    N_FAIL_COUNT=0
    save_state
    log_step "Passed: NzbDAV is UP (fail count reset)."
    exit 0
fi

# --- 3.3 RECOVERY LADDER ---
log_step "[!] Failed: NzbDAV is DOWN (mount=$MOUNT_OK backend=$BACKEND_OK, fail count $N_FAIL_COUNT/$MAX_FAILURES)."
if [ "$NZB_STATE" != "DOWN" ]; then
    send_notification "Mount Down" "NzbDAV check failed at $NZB_MOUNT (mount=$MOUNT_OK backend=$BACKEND_OK). Recovering." "alert"
fi
set_nzb_state "DOWN"

if [ "$N_FAIL_COUNT" -ge "$MAX_FAILURES" ]; then
    if container_restart_allowed; then
        log_step "[CRITICAL] $MAX_FAILURES consecutive recoveries failed."
        hard_reset "N"
        log_step "Hard reset done; mount will be re-checked next run. EXITING."
    else
        save_state
    fi
    exit 1
fi

# Rung selection: fail #0 → rclone, #1 → InfiniDysk + rclone, #2+ → container.
# A dead backend skips straight to restarting InfiniDysk — restarting rclone alone
# can't bring the WebDAV server back.
RUNG="container"
if api_configured; then
    if [ "$N_FAIL_COUNT" -eq 0 ] && [ "$BACKEND_OK" = "true" ]; then
        RUNG="rclone"
    elif [ "$N_FAIL_COUNT" -le 1 ]; then
        RUNG="infinidysk"
    fi
fi

ACTION_TAKEN=false
if [ "$RUNG" != "container" ]; then
    if api_login; then
        if [ "$RUNG" = "rclone" ]; then
            api_restart "$DUMB_RCLONE_PROCESS" && ACTION_TAKEN=true
        else
            api_restart "$DUMB_NZB_PROCESS" && api_restart "$DUMB_RCLONE_PROCESS" && ACTION_TAKEN=true
        fi
    else
        log_step "[!] API: login to $DUMB_API_URL failed — falling back to a container restart."
    fi
    if [ "$ACTION_TAKEN" = "false" ]; then
        RUNG="container"
    fi
fi

if [ "$RUNG" = "container" ]; then
    if ! container_restart_allowed; then
        # Cooldown skip is not a failed recovery — don't count it.
        save_state
        exit 1
    fi
    log_step "FIX: docker restart $DUMB_CONTAINER..."
    docker restart "$DUMB_CONTAINER" > /dev/null 2>&1
    FOUNDATION_LAST_RESTART_TS=$(date +%s)
    ACTION_TAKEN=true
fi

LAST_RECOVERY_TS=$(date +%s)
LAST_RECOVERY_ACTION="$RUNG"

if wait_for_mount; then
    set_nzb_state "UP"
    N_FAIL_COUNT=0
    save_state
    send_notification "Mount Restored" "NzbDAV mount recovered via $RUNG restart." "normal"
    exit 0
fi

N_FAIL_COUNT=$((N_FAIL_COUNT + 1))
save_state
log_step "[!] Recovery via $RUNG did not bring the mount back (fail count $N_FAIL_COUNT/$MAX_FAILURES)."
send_notification "Mount Down" "NzbDAV recovery via $RUNG failed ($N_FAIL_COUNT/$MAX_FAILURES)." "alert"
exit 1
